{
  "name": "GoodBros",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"wait-on -t 60000 http-get://127.0.0.1:5000/api/health && npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wait-on": "^9.5.1"
  }
}
